{
  "family": "library-ng-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::533267145144:role/LabRole",
  "containerDefinitions": [
    {
      "name": "library-ng",
      "image": "533267145144.dkr.ecr.us-east-1.amazonaws.com/library-ng:REPLACE_AFTER_PUBLISH_ECR",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 80,
          "hostPort": 80,
          "protocol": "tcp"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/library-ng",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
